# PostgreSQL connection string (required)
# Local Postgres: localhost:5432
# Docker Compose (host → Postgres): localhost:5435
DATABASE_URL="postgresql://postgres:password@localhost:5432/qrcode_db"

# Backend HTTP port (optional; default 3001)
# Docker Compose publishes the API on host port 3011
PORT=3001

# Node environment (optional)
NODE_ENV=development
